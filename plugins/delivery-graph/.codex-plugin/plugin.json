{
  "name": "delivery-graph",
  "version": "0.42.1",
  "description": "确认 Git 基线，以显式 rootId 管理多 Delivery，在当前 workspace 串行调度 GROUP/TASK，并支持冻结开发包、验收与恢复",
  "author": {
    "name": "delivery-graph contributors",
    "url": "https://github.com/feng123321li/layered-delivery"
  },
  "homepage": "https://github.com/feng123321li/layered-delivery",
  "repository": "https://github.com/feng123321li/layered-delivery",
  "license": "MIT",
  "keywords": [
    "ai-development",
    "graph-scheduling",
    "recursive-graph",
    "manual-handoff",
    "review-governance",
    "automatic-agent-dispatch",
    "serial-workspace",
    "group-task",
    "task-loop"
  ],
  "skills": "./skills/",
  "mcpServers": {
    "delivery-graph": {
      "command": "python",
      "args": [
        "-X",
        "utf8",
        "skills/delivery-graph/scripts/hdg_mcp.py",
        "--project-root-from-meta",
        "--tool-profile",
        "planning"
      ],
      "cwd": ".",
      "env": {
        "HDG_HOST_ADAPTER": "codex"
      },
      "supports_parallel_tool_calls": false,
      "default_tools_approval_mode": "approve",
      "tools": {
        "archive_delivery": {
          "approval_mode": "prompt"
        },
        "unfreeze_task_requirement": {
          "approval_mode": "prompt"
        },
        "refreeze_task_requirement": {
          "approval_mode": "prompt"
        }
      }
    },
    "delivery-graph-dispatch": {
      "command": "python",
      "args": [
        "-X",
        "utf8",
        "skills/delivery-graph/scripts/hdg_mcp.py",
        "--project-root-from-meta",
        "--tool-profile",
        "dispatch"
      ],
      "cwd": ".",
      "env": {
        "HDG_HOST_ADAPTER": "codex"
      },
      "supports_parallel_tool_calls": false,
      "default_tools_approval_mode": "approve",
      "tools": {
        "rebuild_graph_run": {
          "approval_mode": "prompt"
        },
        "cancel_graph_run": {
          "approval_mode": "prompt"
        },
        "handoff_ready_automatic_task": {
          "approval_mode": "prompt"
        }
      }
    },
    "delivery-graph-receiver": {
      "command": "python",
      "args": [
        "-X",
        "utf8",
        "skills/delivery-graph/scripts/hdg_mcp.py",
        "--project-root-from-meta",
        "--tool-profile",
        "receiver"
      ],
      "cwd": ".",
      "env": {
        "HDG_HOST_ADAPTER": "codex"
      },
      "supports_parallel_tool_calls": false,
      "default_tools_approval_mode": "approve",
      "tools": {}
    }
  },
  "interface": {
    "displayName": "分层交付 Graph 控制面",
    "shortDescription": "多 Delivery 串行 workspace、Graph 调度与分层审查",
    "longDescription": "每个 Delivery 使用稳定 rootId 和不可变 Revision 管理需求与验收；同一物理 checkout 可绑定多个 Delivery，但只允许队首 Run 执行。前序 Run 终态或到达最终用户确认边界，并满足业务 commit、clean、HEAD 与 receiver/reservation 安全门禁后，后续 Delivery 才能切换自己的冻结分支并恢复；待用户确认只释放物理 turn，不提前完成 Delivery。自动 TASK 与 Review 继续使用 reservation、operation 租约和完整分层治理，Controller 只持久化轻量工作区变更索引，不复制源码 diff。",
    "developerName": "delivery-graph contributors",
    "category": "Productivity",
    "capabilities": [
      "Read",
      "Write"
    ],
    "websiteURL": "https://github.com/feng123321li/layered-delivery",
    "defaultPrompt": [
      "使用 delivery-graph 确认 Git 基线，以显式 rootId 管理多个 Delivery，并在当前 workspace 中串行执行、提交、审查与恢复。"
    ],
    "brandColor": "#2563EB",
    "composerIcon": "./assets/delivery-graph-icon.png",
    "logo": "./assets/delivery-graph-icon.png"
  }
}
