{
  "name": "delivery-graph",
  "version": "0.39.5",
  "description": "确认 Git 基线，冻结并调度分层 GROUP/TASK Graph，支持自动派遣、冻结开发包、分层审查与恢复",
  "author": {
    "name": "delivery-graph contributors",
    "url": "https://github.com/feng123321li/layered-delivery"
  },
  "homepage": "https://github.com/feng123321li/layered-delivery",
  "repository": "https://github.com/feng123321li/layered-delivery",
  "license": "MIT",
  "keywords": [
    "ai-development",
    "graph-scheduling",
    "recursive-graph",
    "manual-handoff",
    "review-governance",
    "automatic-agent-dispatch",
    "git-worktree",
    "group-task",
    "task-loop"
  ],
  "skills": "./skills/",
  "hooks": "./hooks/hooks.json",
  "mcpServers": {
    "delivery-graph": {
      "command": "python",
      "args": [
        "-X",
        "utf8",
        "skills/delivery-graph/scripts/hdg_mcp.py",
        "--project-root-from-meta"
      ],
      "cwd": ".",
      "env": {
        "HDG_HOST_ADAPTER": "codex"
      },
      "supports_parallel_tool_calls": false,
      "default_tools_approval_mode": "approve",
      "tools": {
        "rebuild_graph_run": {
          "approval_mode": "prompt"
        },
        "cancel_graph_run": {
          "approval_mode": "prompt"
        },
        "archive_delivery": {
          "approval_mode": "prompt"
        },
        "unfreeze_task_requirement": {
          "approval_mode": "prompt"
        },
        "refreeze_task_requirement": {
          "approval_mode": "prompt"
        },
        "handoff_ready_automatic_task": {
          "approval_mode": "prompt"
        }
      }
    }
  },
  "interface": {
    "displayName": "分层交付 Graph 控制面",
    "shortDescription": "冻结基线、调度 Graph、分层审查与恢复",
    "longDescription": "每个 Delivery 使用稳定身份和不可变 Revision 管理验收前的需求调整；Codex 自动模式由 SessionStart 或当前任务调用时 Hook 认证 Delivery 顶层会话并直接实现 TASK，所有 Review 仍由独立 receiver 完成，不需要修改模型 tool mode。Git workspace 身份绑定仓库与冻结分支，不受 linked worktree 路径移动影响。手动模式先冻结自包含 handoff，接收 CLI 开发前启动同一 Graph；TASK、GROUP、Delivery Review 与最终确认均沿用完整治理流程。",
    "developerName": "delivery-graph contributors",
    "category": "Productivity",
    "capabilities": [
      "Read",
      "Write"
    ],
    "websiteURL": "https://github.com/feng123321li/layered-delivery",
    "defaultPrompt": [
      "使用 delivery-graph 确认 Git 基线，冻结并调度分层 GROUP/TASK Graph；Codex 自动模式由 Hook 认证的当前 Delivery 会话实现 TASK，并由独立 receiver 完成 Review。"
    ],
    "brandColor": "#2563EB"
  }
}
