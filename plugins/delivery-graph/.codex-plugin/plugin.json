{
  "name": "delivery-graph",
  "version": "0.37.3",
  "description": "确认 Git 基线，冻结并调度分层 GROUP/TASK Graph，支持自动派遣、冻结开发包、分层审查与恢复",
  "author": {
    "name": "delivery-graph contributors",
    "url": "https://github.com/feng123321li/layered-delivery"
  },
  "homepage": "https://github.com/feng123321li/layered-delivery",
  "repository": "https://github.com/feng123321li/layered-delivery",
  "license": "MIT",
  "keywords": [
    "ai-development",
    "graph-scheduling",
    "recursive-graph",
    "manual-handoff",
    "review-governance",
    "automatic-agent-dispatch",
    "git-worktree",
    "group-task",
    "task-loop"
  ],
  "skills": "./skills/",
  "mcpServers": {
    "delivery-graph": {
      "command": "python",
      "args": [
        "-X",
        "utf8",
        "skills/delivery-graph/scripts/hdg_mcp.py",
        "--project-root-from-meta"
      ],
      "cwd": ".",
      "env": {
        "HDG_HOST_ADAPTER": "codex"
      },
      "supports_parallel_tool_calls": false,
      "default_tools_approval_mode": "approve",
      "tools": {
        "rebuild_graph_run": {
          "approval_mode": "prompt"
        },
        "cancel_graph_run": {
          "approval_mode": "prompt"
        },
        "archive_delivery": {
          "approval_mode": "prompt"
        },
        "unfreeze_task_requirement": {
          "approval_mode": "prompt"
        },
        "refreeze_task_requirement": {
          "approval_mode": "prompt"
        }
      }
    }
  },
  "interface": {
    "displayName": "分层交付 Graph 控制面",
    "shortDescription": "冻结基线、调度 Graph、分层审查与恢复",
    "longDescription": "每个 Delivery 使用稳定身份和不可变 Revision 管理验收前的需求调整；自动模式由当前可信宿主预留独立 receiver 并继承宿主模型，不在控制面推荐或调整模型。手动模式先冻结自包含 handoff，接收 CLI 开发前启动同一 Graph；只有 TASK 实现使用手动 claim，TASK、GROUP、Delivery Review 与最终确认均沿用完整治理流程。内部 Worker 的模型信息只读展示，同时以中文表格汇总后台进度、测试、心跳、剩余租约和失联预警。",
    "developerName": "delivery-graph contributors",
    "category": "Productivity",
    "capabilities": [
      "Read",
      "Write"
    ],
    "websiteURL": "https://github.com/feng123321li/layered-delivery",
    "defaultPrompt": [
      "使用 delivery-graph 确认 Git 基线，冻结并调度分层 GROUP/TASK Graph；自动模式由当前宿主 receiver 执行，手动模式由接收 CLI 在开发前启动同一 Graph。"
    ],
    "brandColor": "#2563EB"
  }
}
