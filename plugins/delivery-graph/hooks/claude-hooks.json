{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_delivery-graph_delivery-graph__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['CLAUDE_PLUGIN_ROOT'],'hooks','attest_claude_workspace.py'),run_name='__main__')\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__plugin_delivery-graph_delivery-graph__dispatch_loop",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['CLAUDE_PLUGIN_ROOT'],'hooks','attest_claude_dispatch_receiver.py'),run_name='__main__')\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__plugin_delivery-graph_delivery-graph__rebuild_graph_run",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['CLAUDE_PLUGIN_ROOT'],'hooks','require_sensitive_tool_approval.py'),run_name='__main__')\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__plugin_delivery-graph_delivery-graph__cancel_graph_run",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['CLAUDE_PLUGIN_ROOT'],'hooks','require_sensitive_tool_approval.py'),run_name='__main__')\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__plugin_delivery-graph_delivery-graph__archive_delivery",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['CLAUDE_PLUGIN_ROOT'],'hooks','require_sensitive_tool_approval.py'),run_name='__main__')\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__plugin_delivery-graph_delivery-graph__unfreeze_task_requirement",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['CLAUDE_PLUGIN_ROOT'],'hooks','require_sensitive_tool_approval.py'),run_name='__main__')\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__plugin_delivery-graph_delivery-graph__refreeze_task_requirement",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['CLAUDE_PLUGIN_ROOT'],'hooks','require_sensitive_tool_approval.py'),run_name='__main__')\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__.*__(heartbeat_loop|report_loop_progress|pause_loop|record_loop_result)$",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['CLAUDE_PLUGIN_ROOT'],'hooks','authorize_loop_operation.py'),run_name='__main__')\"",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['CLAUDE_PLUGIN_ROOT'],'hooks','handle_claude_rate_limit.py'),run_name='__main__')\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
