{
  "description": "Codex lifecycle hooks for Delivery Graph receivers.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 \"${PLUGIN_ROOT}/hooks/attest_codex_session_receiver.py\"",
            "commandWindows": "python -X utf8 \"%PLUGIN_ROOT%\\hooks\\attest_codex_session_receiver.py\"",
            "timeout": 15,
            "statusMessage": "Attesting Delivery Graph session",
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__.*__(plan_dispatch_batch|claim_current_task)$",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 \"${PLUGIN_ROOT}/hooks/attest_codex_dispatch_preflight.py\"",
            "commandWindows": "python -X utf8 \"%PLUGIN_ROOT%\\hooks\\attest_codex_dispatch_preflight.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__.*__dispatch_loop$",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 \"${PLUGIN_ROOT}/hooks/attest_codex_dispatch_receiver.py\"",
            "commandWindows": "python -X utf8 \"%PLUGIN_ROOT%\\hooks\\attest_codex_dispatch_receiver.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__.*__(heartbeat_loop|report_loop_progress|pause_loop|record_loop_result)$",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 \"${PLUGIN_ROOT}/hooks/authorize_loop_operation.py\"",
            "commandWindows": "python -X utf8 \"%PLUGIN_ROOT%\\hooks\\authorize_loop_operation.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 \"${PLUGIN_ROOT}/hooks/attest_codex_subagent_receiver.py\"",
            "commandWindows": "python -X utf8 \"%PLUGIN_ROOT%\\hooks\\attest_codex_subagent_receiver.py\"",
            "timeout": 30,
            "statusMessage": "Attesting Delivery Graph receiver"
          }
        ]
      }
    ]
  }
}
