{
  "name": "layered-delivery",
  "version": "0.28.3",
  "description": "调度递归 GROUP/TASK、不可变 Revision、跨仓分支与宿主原生 Agent/Model 自动派遣",
  "author": {
    "name": "layered-delivery contributors",
    "url": "https://github.com/feng123321li/layered-delivery"
  },
  "homepage": "https://github.com/feng123321li/layered-delivery",
  "repository": "https://github.com/feng123321li/layered-delivery",
  "license": "MIT",
  "keywords": [
    "ai-development",
    "graph-scheduling",
    "recursive-graph",
    "agent-discovery",
    "model-recommendation",
    "automatic-agent-dispatch",
    "git-worktree",
    "group-task",
    "task-loop"
  ],
  "skills": "./skills/",
  "mcpServers": {
    "layered-delivery": {
      "command": "python",
      "args": [
        "-X",
        "utf8",
        "skills/layered-delivery/scripts/hdg_mcp.py",
        "--project-root-from-meta"
      ],
      "cwd": ".",
      "env": {
        "HDG_HOST_ADAPTER": "codex"
      },
      "supports_parallel_tool_calls": false,
      "default_tools_approval_mode": "approve",
      "tools": {
        "rebuild_graph_run": {
          "approval_mode": "prompt"
        },
        "cancel_graph_run": {
          "approval_mode": "prompt"
        },
        "unfreeze_task_requirement": {
          "approval_mode": "prompt"
        },
        "refreeze_task_requirement": {
          "approval_mode": "prompt"
        }
      }
    }
  },
  "interface": {
    "displayName": "递归交付调度",
    "shortDescription": "递归 Graph 与 Agent/Model 自动派遣",
    "longDescription": "每个 Delivery 使用稳定身份和不可变 Revision 管理验收前的需求调整；内部递归调度 GROUP 与 TASK，并按宿主真实容量为当前 frontier 显式选择模型、并发创建原生 Agent，同时治理跨仓分支、资源锁、租约、Review Loop、结果继承和最终确认。",
    "developerName": "layered-delivery contributors",
    "category": "Productivity",
    "capabilities": [
      "Interactive",
      "Write"
    ],
    "websiteURL": "https://github.com/feng123321li/layered-delivery",
    "defaultPrompt": [
      "使用 layered-delivery 恢复或创建递归 GROUP/TASK 交付 Graph；自动模式按宿主容量显式选择模型并并发派遣原生 Agent。"
    ],
    "brandColor": "#2563EB"
  }
}
