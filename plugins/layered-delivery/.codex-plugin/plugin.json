{
  "name": "layered-delivery",
  "version": "0.18.1",
  "description": "调度递归 GROUP/TASK 工作树与多项目、多模块交付的 Graph 插件",
  "author": {
    "name": "layered-delivery contributors",
    "url": "https://github.com/feng123321li/layered-delivery"
  },
  "homepage": "https://github.com/feng123321li/layered-delivery",
  "repository": "https://github.com/feng123321li/layered-delivery",
  "license": "MIT",
  "keywords": [
    "ai-development",
    "graph-scheduling",
    "recursive-graph",
    "group-task",
    "task-loop"
  ],
  "skills": "./skills/",
  "mcpServers": {
    "layered-delivery": {
      "command": "python",
      "args": [
        "-X",
        "utf8",
        "skills/layered-delivery/scripts/hdg_mcp.py",
        "--project-root-from-meta"
      ],
      "cwd": ".",
      "supports_parallel_tool_calls": false,
      "default_tools_approval_mode": "approve",
      "tools": {
        "rebuild_graph_run": {
          "approval_mode": "prompt"
        },
        "cancel_graph_run": {
          "approval_mode": "prompt"
        },
        "record_user_confirmation": {
          "approval_mode": "prompt"
        }
      }
    }
  },
  "interface": {
    "displayName": "递归交付调度",
    "shortDescription": "递归调度 GROUP/TASK 交付 Graph",
    "longDescription": "每个 Delivery 定义一次交付与验收边界，内部递归调度 GROUP 与执行叶子 TASK；只治理依赖、资源锁、租约、重试、GROUP Join、逐级 Review Loop 和最终确认。",
    "developerName": "layered-delivery contributors",
    "category": "Productivity",
    "capabilities": [
      "Interactive",
      "Write"
    ],
    "websiteURL": "https://github.com/feng123321li/layered-delivery",
    "defaultPrompt": [
      "使用 layered-delivery 检查调度状态，恢复或创建递归 GROUP/TASK 交付 Graph，并以 Delivery ID 区分需求投影。"
    ],
    "brandColor": "#2563EB"
  }
}
