{
  "name": "layered-delivery",
  "version": "0.17.0",
  "description": "面向可插拔 Task Loop 的分层交付 Graph 调度插件",
  "author": {
    "name": "layered-delivery contributors",
    "url": "https://github.com/feng123321li/layered-delivery"
  },
  "homepage": "https://github.com/feng123321li/layered-delivery",
  "repository": "https://github.com/feng123321li/layered-delivery",
  "license": "MIT",
  "keywords": [
    "ai-development",
    "graph-scheduling",
    "task-loop"
  ],
  "skills": "./skills/",
  "mcpServers": {
    "layered-delivery": {
      "command": "python",
      "args": [
        "-X",
        "utf8",
        "skills/layered-delivery/scripts/hdg_mcp.py",
        "--project-root-from-meta"
      ],
      "cwd": ".",
      "supports_parallel_tool_calls": false,
      "default_tools_approval_mode": "approve",
      "tools": {
        "freeze_hierarchy": {
          "approval_mode": "prompt"
        },
        "rebuild_graph_run": {
          "approval_mode": "prompt"
        },
        "cancel_graph_run": {
          "approval_mode": "prompt"
        },
        "record_user_confirmation": {
          "approval_mode": "prompt"
        }
      }
    }
  },
  "interface": {
    "displayName": "分层交付调度",
    "shortDescription": "调度多项目、多模块的 Task Loop 与交付 Graph",
    "longDescription": "以外层 Graph 调度可插拔 Task Loop，只治理依赖、资源锁、租约、重试、Join、Review Loop 和最终确认。",
    "developerName": "layered-delivery contributors",
    "category": "Productivity",
    "capabilities": [
      "Interactive",
      "Write"
    ],
    "websiteURL": "https://github.com/feng123321li/layered-delivery",
    "defaultPrompt": [
      "使用 layered-delivery 检查调度状态，并恢复或创建最浅合法的交付 Graph。"
    ],
    "brandColor": "#2563EB"
  }
}
