{
  "name": "layered-delivery",
  "version": "0.32.0",
  "description": "预览和调度递归 GROUP/TASK、原生模型分档、开发内容交接与中文进度",
  "author": {
    "name": "layered-delivery contributors",
    "url": "https://github.com/feng123321li/layered-delivery"
  },
  "homepage": "https://github.com/feng123321li/layered-delivery",
  "repository": "https://github.com/feng123321li/layered-delivery",
  "license": "MIT",
  "keywords": [
    "ai-development",
    "graph-scheduling",
    "recursive-graph",
    "agent-discovery",
    "model-recommendation",
    "automatic-agent-dispatch",
    "git-worktree",
    "group-task",
    "task-loop"
  ],
  "skills": "./skills/",
  "mcpServers": {
    "layered-delivery": {
      "command": "python",
      "args": [
        "-X",
        "utf8",
        "skills/layered-delivery/scripts/hdg_mcp.py",
        "--project-root-from-meta"
      ],
      "cwd": ".",
      "env": {
        "HDG_HOST_ADAPTER": "codex"
      },
      "supports_parallel_tool_calls": false,
      "default_tools_approval_mode": "approve",
      "tools": {
        "rebuild_graph_run": {
          "approval_mode": "prompt"
        },
        "cancel_graph_run": {
          "approval_mode": "prompt"
        },
        "unfreeze_task_requirement": {
          "approval_mode": "prompt"
        },
        "refreeze_task_requirement": {
          "approval_mode": "prompt"
        },
        "update_orchestrator_settings": {
          "approval_mode": "prompt"
        }
      }
    }
  },
  "interface": {
    "displayName": "递归交付调度",
    "shortDescription": "递归 Graph、原生模型路由与开发内容交接",
    "longDescription": "每个 Delivery 使用稳定身份和不可变 Revision 管理验收前的需求调整；自动模式在实际开发工作区内按宿主原生模型分档路由，通过 30 秒可调整窗口后并发派遣；手动模式只生成一个不绑定 Agent、模型或 worktree 的自包含开发内容文件。转发后的实际模型只读展示，同时以中文表格汇总后台进度、测试、心跳、剩余租约和失联预警。",
    "developerName": "layered-delivery contributors",
    "category": "Productivity",
    "capabilities": [
      "Interactive",
      "Write"
    ],
    "websiteURL": "https://github.com/feng123321li/layered-delivery",
    "defaultPrompt": [
      "使用 layered-delivery 只读预览或恢复递归 GROUP/TASK 交付 Graph；自动模式开始开发时创建工作区并选择宿主原生模型，手动模式只生成自包含开发内容交接文件。"
    ],
    "brandColor": "#2563EB"
  }
}
