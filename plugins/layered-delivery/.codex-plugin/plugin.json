{
  "name": "layered-delivery",
  "version": "0.27.0",
  "description": "调度递归 GROUP/TASK 交付 Graph，并投影实际 Agent/模型与接口字段变更",
  "author": {
    "name": "layered-delivery contributors",
    "url": "https://github.com/feng123321li/layered-delivery"
  },
  "homepage": "https://github.com/feng123321li/layered-delivery",
  "repository": "https://github.com/feng123321li/layered-delivery",
  "license": "MIT",
  "keywords": [
    "ai-development",
    "graph-scheduling",
    "recursive-graph",
    "agent-discovery",
    "model-recommendation",
    "git-worktree",
    "group-task",
    "task-loop"
  ],
  "skills": "./skills/",
  "mcpServers": {
    "layered-delivery": {
      "command": "python",
      "args": [
        "-X",
        "utf8",
        "skills/layered-delivery/scripts/hdg_mcp.py",
        "--project-root-from-meta"
      ],
      "cwd": ".",
      "supports_parallel_tool_calls": false,
      "default_tools_approval_mode": "approve",
      "tools": {
        "rebuild_graph_run": {
          "approval_mode": "prompt"
        },
        "cancel_graph_run": {
          "approval_mode": "prompt"
        },
        "unfreeze_task_requirement": {
          "approval_mode": "prompt"
        },
        "refreeze_task_requirement": {
          "approval_mode": "prompt"
        }
      }
    }
  },
  "interface": {
    "displayName": "递归交付调度",
    "shortDescription": "递归调度 Graph，展示实际 Agent、模型与接口变更",
    "longDescription": "每个 Delivery 定义一次交付与验收边界，内部递归调度 GROUP 与执行叶子 TASK；治理依赖、资源锁、租约、重试、GROUP Join、逐级 Review Loop 和最终确认，并投影实际执行 Agent、模型、认领身份、执行轮次及接口字段变更。",
    "developerName": "layered-delivery contributors",
    "category": "Productivity",
    "capabilities": [
      "Interactive",
      "Write"
    ],
    "websiteURL": "https://github.com/feng123321li/layered-delivery",
    "defaultPrompt": [
      "使用 layered-delivery 恢复或创建递归 GROUP/TASK 交付 Graph，并展示实际执行 Agent、模型和接口字段变更。"
    ],
    "brandColor": "#2563EB"
  }
}
