{
  "name": "layered-delivery",
  "version": "0.28.0",
  "description": "调度支持不可变 Revision 与跨仓同名分支的递归 GROUP/TASK 交付 Graph",
  "author": {
    "name": "layered-delivery contributors",
    "url": "https://github.com/feng123321li/layered-delivery"
  },
  "homepage": "https://github.com/feng123321li/layered-delivery",
  "repository": "https://github.com/feng123321li/layered-delivery",
  "license": "MIT",
  "keywords": [
    "ai-development",
    "graph-scheduling",
    "recursive-graph",
    "agent-discovery",
    "model-recommendation",
    "git-worktree",
    "group-task",
    "task-loop"
  ],
  "skills": "./skills/",
  "mcpServers": {
    "layered-delivery": {
      "command": "python",
      "args": [
        "-X",
        "utf8",
        "skills/layered-delivery/scripts/hdg_mcp.py",
        "--project-root-from-meta"
      ],
      "cwd": ".",
      "supports_parallel_tool_calls": false,
      "default_tools_approval_mode": "approve",
      "tools": {
        "rebuild_graph_run": {
          "approval_mode": "prompt"
        },
        "cancel_graph_run": {
          "approval_mode": "prompt"
        },
        "unfreeze_task_requirement": {
          "approval_mode": "prompt"
        },
        "refreeze_task_requirement": {
          "approval_mode": "prompt"
        }
      }
    }
  },
  "interface": {
    "displayName": "递归交付调度",
    "shortDescription": "同一 Delivery 修订与跨仓同名分支调度",
    "longDescription": "每个 Delivery 使用稳定身份和不可变 Revision 管理验收前的需求调整，可在冻结前精确授权多个本地仓库，并强制所有可写仓库使用同名 feature 分支；内部递归调度 GROUP 与 TASK，治理依赖、资源锁、租约、Review Loop、结果继承和最终确认。",
    "developerName": "layered-delivery contributors",
    "category": "Productivity",
    "capabilities": [
      "Interactive",
      "Write"
    ],
    "websiteURL": "https://github.com/feng123321li/layered-delivery",
    "defaultPrompt": [
      "使用 layered-delivery 恢复或创建递归 GROUP/TASK 交付 Graph，并管理同一 Delivery 的 Revision 与跨仓同名分支。"
    ],
    "brandColor": "#2563EB"
  }
}
