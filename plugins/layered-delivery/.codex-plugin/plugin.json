{
  "name": "layered-delivery",
  "version": "0.34.5",
  "description": "预览和调度递归 GROUP/TASK、当前宿主 receiver、完整手动交接审查、冻结开发包与中文进度",
  "author": {
    "name": "layered-delivery contributors",
    "url": "https://github.com/feng123321li/layered-delivery"
  },
  "homepage": "https://github.com/feng123321li/layered-delivery",
  "repository": "https://github.com/feng123321li/layered-delivery",
  "license": "MIT",
  "keywords": [
    "ai-development",
    "graph-scheduling",
    "recursive-graph",
    "manual-handoff",
    "review-governance",
    "automatic-agent-dispatch",
    "git-worktree",
    "group-task",
    "task-loop"
  ],
  "skills": "./skills/",
  "mcpServers": {
    "layered-delivery": {
      "command": "python",
      "args": [
        "-X",
        "utf8",
        "skills/layered-delivery/scripts/hdg_mcp.py",
        "--project-root-from-meta"
      ],
      "cwd": ".",
      "env": {
        "HDG_HOST_ADAPTER": "codex"
      },
      "supports_parallel_tool_calls": false,
      "default_tools_approval_mode": "approve",
      "tools": {
        "rebuild_graph_run": {
          "approval_mode": "prompt"
        },
        "cancel_graph_run": {
          "approval_mode": "prompt"
        },
        "unfreeze_task_requirement": {
          "approval_mode": "prompt"
        },
        "refreeze_task_requirement": {
          "approval_mode": "prompt"
        }
      }
    }
  },
  "interface": {
    "displayName": "递归交付调度",
    "shortDescription": "递归 Graph、当前宿主 receiver 与完整审查",
    "longDescription": "每个 Delivery 使用稳定身份和不可变 Revision 管理验收前的需求调整；自动模式由当前可信宿主预留独立 receiver 并继承宿主模型，不在控制面推荐或调整模型。手动模式先冻结自包含 handoff，接收 CLI 开发前启动同一 Graph；只有 TASK 实现使用手动 claim，TASK、GROUP、Delivery Review 与最终确认均沿用完整治理流程。内部 Worker 的模型信息只读展示，同时以中文表格汇总后台进度、测试、心跳、剩余租约和失联预警。",
    "developerName": "layered-delivery contributors",
    "category": "Productivity",
    "capabilities": [
      "Interactive",
      "Write"
    ],
    "websiteURL": "https://github.com/feng123321li/layered-delivery",
    "defaultPrompt": [
      "使用 layered-delivery 只读预览或恢复递归 GROUP/TASK 交付 Graph；自动模式由当前宿主 receiver 启动开发，手动模式由接收 CLI 在开发前启动同一 Graph，并完整执行分层 Review 与最终确认。"
    ],
    "brandColor": "#2563EB"
  }
}
