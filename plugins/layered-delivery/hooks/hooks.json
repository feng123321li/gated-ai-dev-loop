{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_layered-delivery_layered-delivery__dispatch_loop",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['CLAUDE_PLUGIN_ROOT'],'hooks','attest_claude_dispatch_receiver.py'),run_name='__main__')\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__plugin_layered-delivery_layered-delivery__rebuild_graph_run",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['CLAUDE_PLUGIN_ROOT'],'hooks','require_sensitive_tool_approval.py'),run_name='__main__')\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__plugin_layered-delivery_layered-delivery__cancel_graph_run",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['CLAUDE_PLUGIN_ROOT'],'hooks','require_sensitive_tool_approval.py'),run_name='__main__')\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__plugin_layered-delivery_layered-delivery__unfreeze_task_requirement",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['CLAUDE_PLUGIN_ROOT'],'hooks','require_sensitive_tool_approval.py'),run_name='__main__')\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__plugin_layered-delivery_layered-delivery__refreeze_task_requirement",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['CLAUDE_PLUGIN_ROOT'],'hooks','require_sensitive_tool_approval.py'),run_name='__main__')\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__plugin_layered-delivery_layered-delivery__update_orchestrator_settings",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['CLAUDE_PLUGIN_ROOT'],'hooks','require_sensitive_tool_approval.py'),run_name='__main__')\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__.*__(heartbeat_loop|report_loop_progress|pause_loop|record_loop_result)$",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['CLAUDE_PLUGIN_ROOT'],'hooks','authorize_codex_loop_operation.py'),run_name='__main__')\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['CLAUDE_PLUGIN_ROOT'],'hooks','attest_codex_subagent_receiver.py'),run_name='__main__')\"",
            "timeout": 30,
            "statusMessage": "Attesting Layered Delivery receiver"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['CLAUDE_PLUGIN_ROOT'],'hooks','handle_claude_rate_limit.py'),run_name='__main__')\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
